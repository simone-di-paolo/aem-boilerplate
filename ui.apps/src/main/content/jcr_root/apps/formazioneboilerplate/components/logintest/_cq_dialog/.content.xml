<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Title"
                        name="./title"/>
                    <multifield1
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            fieldDescription="Click to add a new planet"
                            fieldLabel="Scheda Pianeta"
                            margin="{Boolean}true"
                            composite="{Boolean}true">
                        <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                name="./multifield1">
                            <items
                                    jcr:primaryType="nt:unstructured">
                                <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                    <items
                                            jcr:primaryType="nt:unstructured">
                                        <title
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Title"
                                                name="./title"/>
                                        <image
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Image"
                                                rootPath="/content/dam"
                                                name="./image"/>
                                    </items>
                                </column>
                            </items>
                        </field>
                    </multifield1>
                    <multifield2
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            fieldDescription="Click to add a new row"
                            fieldLabel="Riga Tabella Pianeti"
                            margin="{Boolean}true"
                            composite="{Boolean}true">
                        <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                name="./multifield2">
                            <items
                                    jcr:primaryType="nt:unstructured">
                                <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                    <items
                                            jcr:primaryType="nt:unstructured">

                                        <nomepianeta
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Nome Pianeta"
                                                name="./nomepianeta"/>

                                        <selectTemperatura
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType = "granite/ui/components/foundation/form/select"
                                                fieldLabel="Temperatura °K"
                                                name = "./selectTemperatura">
                                            <items jcr:primaryType="nt:unstructured">
                                                <option1
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "-20"
                                                        text = "-20"
                                                        selected="{Boolean}true"/>
                                                <option2
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "-10"
                                                        text = "-10"
                                                        />
                                                <option3
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "0"
                                                        text = "0"
                                                        />
                                                <option4
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "+10"
                                                        text = "+10"
                                                        />

                                                <option5
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "+20"
                                                        text = "+20"
                                                        />
                                                <option6
                                                        jcr:primaryType="nt:unstructured"
                                                        value = "+30"
                                                        text = "+30"
                                                        />
                                            </items>
                                        </selectTemperatura>

                                        <dimensioni
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Dimensioni"
                                                name="./dimensioni"/>
                                        <distanzaterra
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldLabel="Distanza dalla Terra"
                                                name="./distanzaterra"/>

                                    </items>
                                </column>
                            </items>
                        </field>
                    </multifield2>

                </items>
            </column>
        </items>
    </content>
</jcr:root>